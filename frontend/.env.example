# =======================================================================
# Next.js frontend (frontend/) — copy เป็น frontend/.env.local แล้วใส่ค่าจริง (ห้าม commit .env*)
# ตัวแปรที่ขึ้นต้นด้วย NEXT_PUBLIC_ ถูกฝังลงใน JS ฝั่ง browser ตอน build — ห้ามใส่ความลับ
# [REQUIRED] = ไม่ตั้งแล้วฟีเจอร์หลักใช้ไม่ได้
# [OPTIONAL] = มี default หรือแค่ปิดฟีเจอร์นั้น
# ค่าทั้งหมดในไฟล์นี้เป็น placeholder
# =======================================================================

# [OPTIONAL] URL ของ Go backend (default http://localhost:8080)
NEXT_PUBLIC_API_URL=http://localhost:8080
# [OPTIONAL] URL สาธารณะของ frontend ใช้ในลิงก์ QR ลงทะเบียนอุปกรณ์ (default = origin ของหน้าที่เปิดอยู่)
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
# [OPTIONAL] LINE Login channel ID สำหรับปุ่มผูก LINE (ตรงกับ LINE_LOGIN_CHANNEL_ID ของ backend)
NEXT_PUBLIC_LINE_CLIENT_ID=your-line-login-channel-id

# ---------- next-auth (server-side เท่านั้น) ----------
# [REQUIRED] secret ของ next-auth สำหรับเข้ารหัส session — สุ่มยาว ๆ เช่น `openssl rand -base64 32`
NEXTAUTH_SECRET=replace-with-a-long-random-string
# [OPTIONAL ใน dev, REQUIRED ใน production] URL ของ frontend ที่ next-auth ใช้สร้าง callback (อ่านโดย next-auth เอง)
NEXTAUTH_URL=http://localhost:3000
# [OPTIONAL] Google OAuth client ID — ต้องตรงกับ GOOGLE_CLIENT_ID ใน backend/.env
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# [OPTIONAL] Google OAuth client secret — ไม่ตั้ง = Google login ใช้ไม่ได้
GOOGLE_CLIENT_SECRET=your-google-client-secret
