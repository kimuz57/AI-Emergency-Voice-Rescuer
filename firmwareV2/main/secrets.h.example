// secrets.h.example -- committed template. DO NOT put real credentials here.
//
// Setup:  cp main/secrets.h.example main/secrets.h   then edit main/secrets.h.
// main/secrets.h is gitignored (firmwareV2/.gitignore) and is required to build:
// main.c stops with #error if it is missing.
//
// One username/password pair per environment. main.c selects the pair that
// matches DEPLOY_ENV (ENV_LOCAL / ENV_SERVER / ENV_LAB).
// Ask the backend owner for the broker credentials; rotate them on the broker
// if they ever leak (e.g. get committed).
#ifndef SECRETS_H
#define SECRETS_H

// ENV_LOCAL  -> ws://<dev-pc>:9001/mqtt
#define MQTT_USER_LOCAL "CHANGE_ME"
#define MQTT_PASS_LOCAL "CHANGE_ME"

// ENV_SERVER -> production broker (TARGET_MQTT_URI in main.c)
#define MQTT_USER_SERVER "CHANGE_ME"
#define MQTT_PASS_SERVER "CHANGE_ME"

// ENV_LAB    -> lab broker
#define MQTT_USER_LAB "CHANGE_ME"
#define MQTT_PASS_LAB "CHANGE_ME"

#endif // SECRETS_H
