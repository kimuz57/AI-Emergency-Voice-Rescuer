# =======================================================================
# Python AI server + MQTT receiver (api/) — copy เป็น api/.env แล้วใส่ค่าจริง (ห้าม commit .env)
# อ่านโดย api/mqtt_audio_receiver.py (load_dotenv) ซึ่ง app.py import ตอน start
# [REQUIRED] = ไม่ตั้งแล้ว `uvicorn app:app` start ไม่ขึ้น (ValueError ตอน import)
# [OPTIONAL] = มี default
# ค่าทั้งหมดในไฟล์นี้เป็น placeholder
# =======================================================================

# [OPTIONAL] development = พ่น log ต่อ chunk/ผลทำนาย, ค่าอื่น = เงียบ (default development)
APP_ENV=development

# ---------- MQTT broker (mosquitto/) ----------
# [REQUIRED] host ของ Mosquitto (เครื่องเดียวกับ docker-compose: localhost)
MQTT_BROKER_HOST=localhost
# [OPTIONAL] พอร์ต broker: 1883 = MQTT, 9001 = WS, 8083 = WSS (default 8083)
MQTT_BROKER_PORT=8083
# [OPTIONAL] true/false บังคับเปิด/ปิด TLS — ไม่ตั้ง = เปิด TLS อัตโนมัติเมื่อพอร์ตเป็น 443/8883/8083
MQTT_USE_TLS=
# [OPTIONAL แต่ต้องมีเมื่อ broker ตั้ง allow_anonymous false] user ใน mosquitto/config/passwd
MQTT_USER=ai-receiver
# [OPTIONAL แต่ต้องมีคู่กับ MQTT_USER] รหัสผ่านของ user นั้น
MQTT_PASSWORD=change-me
# [OPTIONAL] true = ข้ามการตรวจ certificate ทั้ง MQTT และ HTTP ไป Go (self-signed, dev เท่านั้น เสี่ยง MITM) (default false)
TLS_INSECURE_SKIP_VERIFY=false

# ---------- Go backend ----------
# [REQUIRED] base URL ของ Go backend (ไม่มี / ท้าย) — ไป host อื่นที่ไม่ใช่เครื่องตัวเองควรเป็น https://
GO_SERVER_URL=http://localhost:8080
# [REQUIRED] คีย์ header X-Internal-Key ต้องเป็นค่าเดียวกับ INTERNAL_API_KEY ใน backend/.env
INTERNAL_API_KEY=replace-with-a-long-random-string

# ---------- Audio ----------
# [OPTIONAL] sample rate ของ PCM ที่บอร์ดส่งมา ต้องตรงกับ I2S_SAMPLE_RATE ใน firmware (default 8000)
SAMPLE_RATE=8000

# ---------- DSP (dsp.py) — ทุกค่าไม่บังคับ ไม่ตั้ง/ว่าง = default ----------
# โหมด: mono = ไมค์ซ้ายตัวเดียว (ฐานเปรียบเทียบ), das_pf = Delay-and-Sum + Coherence post-filter, mvdr = MVDR (default das_pf)
DSP_MODE=das_pf
# log เวลาที่ใช้ของแต่ละขั้น (ms) ทุกหน้าต่าง สำหรับทดสอบ AR-04 (default true)
DSP_LOG_TIMING=true
# HPF Butterworth (default 100 Hz, อันดับ 2)
DSP_HPF_CUTOFF_HZ=
DSP_HPF_ORDER=
# AGC: ขยายสูงสุด (default 4) และระดับ RMS เป้าหมายของเฟรมดัง (default -20 dBFS)
DSP_AGC_MAX_GAIN=
DSP_AGC_TARGET_DBFS=
# VAD: ดังกว่าพื้นหลังอย่างน้อย (default 6 dB) นานอย่างน้อยสัดส่วนนี้ของหน้าต่าง (default 0.10)
DSP_VAD_THRESHOLD_DB=
DSP_VAD_MIN_SPEECH_RATIO=
# ระดับพื้นหลัง = เปอร์เซ็นไทล์ของพลังงานเฟรม (default 10) และขึ้นได้ไม่เกินกี่ dB ต่อหน้าต่าง (default 1)
DSP_VAD_FLOOR_PERCENTILE=
DSP_VAD_FLOOR_RISE_DB=
# GCC-PHAT: ช่วงค้นหา ± ค่าตัวอย่าง (default 3 = ไมค์ห่าง 10 ซม.) และตัวคูณความละเอียด (default 16)
DSP_GCC_MAX_LAG=
DSP_GCC_INTERP=
# STFT (default 256 / 128, Hann)
DSP_STFT_NFFT=
DSP_STFT_HOP=
# Post-filter: Gmin (default 0.1), ค่าปรับเรียบ λ (default 0.95)
DSP_PF_GMIN=
DSP_PF_LAMBDA=
# MVDR: diagonal loading สัมพัทธ์ (default 0.01), เฟรมเงียบขั้นต่ำ (default 8), น้ำหนัก Rn เดิมข้ามหน้าต่าง (default 0.9)
DSP_MVDR_DIAG_LOAD=
DSP_MVDR_MIN_NOISE_FRAMES=
DSP_MVDR_NOISE_MEMORY=
