# =======================================================================
# Go backend (backend/) — copy เป็น backend/.env แล้วใส่ค่าจริง (ห้าม commit .env)
# [REQUIRED] = ไม่ตั้งแล้ว backend ไม่ start (log.Fatal)
# [OPTIONAL] = มี default หรือแค่ปิดฟีเจอร์นั้น / เตือนใน log
# ค่าทั้งหมดในไฟล์นี้เป็น placeholder
# docker-compose.yml อ่านไฟล์นี้ได้ด้วย: docker compose --env-file backend/.env up -d
# =======================================================================
 
# ---------- Server ----------
# [OPTIONAL] พอร์ตที่ Fiber listen (default 8080)
PORT=8080
# [OPTIONAL] development = พ่น log request/debug, ค่าอื่น (เช่น production) = ปิด (default development)
APP_ENV=development
# [OPTIONAL] URL สาธารณะของ backend ใช้ประกอบลิงก์ไฟล์เสียง/รูป (default http://localhost:8080)
API_BASE_URL=http://localhost:8080
# [OPTIONAL] URL ของ frontend: ใช้เป็น CORS AllowOrigins และลิงก์ในอีเมล/LINE/Telegram (default http://localhost:3000)
FRONTEND_URL=http://localhost:3000

# ---------- PostgreSQL ----------
# [REQUIRED] host ของ PostgreSQL (docker-compose: localhost)
DB_HOST=localhost
# [REQUIRED] user ของ PostgreSQL (docker-compose ใช้ค่าเดียวกันสร้าง user)
DB_USER=guardian
# [REQUIRED] รหัสผ่าน PostgreSQL (placeholder ตรงกับ default ใน docker-compose.yml)
DB_PASSWORD=change-me-dev-only
# [REQUIRED] ชื่อฐานข้อมูล
DB_NAME=guardian
# [OPTIONAL] พอร์ต PostgreSQL บน host (default 5433 = port ที่ docker-compose map ไว้)
DB_PORT=5433

# ---------- Redis (ต้องต่อได้ ไม่งั้น backend log.Fatal) ----------
# [OPTIONAL] host ของ Redis (default localhost)
REDIS_HOST=localhost
# [OPTIONAL] พอร์ต Redis (default 6379)
REDIS_PORT=6379
# [OPTIONAL] รหัสผ่าน Redis ปล่อยว่าง = ไม่ใช้รหัส (ต้องตรงกับ docker-compose)
REDIS_PASSWORD=

# ---------- Auth / Security ----------
# [REQUIRED] secret สำหรับเซ็น JWT และ alert token — สุ่มยาว ๆ เช่น `openssl rand -hex 32`
JWT_SECRET=replace-with-a-long-random-string
# [OPTIONAL แต่ต้องตั้งถ้าจะใช้ pipeline] คีย์ header X-Internal-Key ของ route ภายใน
# (Python receiver -> /api/audio/*, /api/alerts, /api/device/status, /api/device/check-activation)
# ต้องเป็นค่าเดียวกับ INTERNAL_API_KEY ใน api/.env — ไม่ตั้ง = route เหล่านั้นตอบ 503
INTERNAL_API_KEY=replace-with-a-long-random-string
# [OPTIONAL] Google OAuth client ID สำหรับตรวจ ID token ที่ POST /api/auth/google
# ต้องตรงกับ GOOGLE_CLIENT_ID ของ frontend — ไม่ตั้ง = Google login ตอบ 500
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# [OPTIONAL] อีเมลของ admin เริ่มต้นที่สร้างตอน start ถ้ายังไม่มี admin ในระบบ (default admin@evr.com)
ADMIN_EMAIL=admin@example.com
# [OPTIONAL] รหัสผ่าน admin เริ่มต้น (ควรยาว >= 12 ตัว) — ไม่ตั้ง = ไม่สร้าง admin ให้
ADMIN_PASSWORD=

# ---------- LINE ----------
# [REQUIRED] Channel secret ของ LINE Messaging API (ใช้ตรวจ webhook /webhook)
LINE_CHANNEL_SECRET=your-line-channel-secret
# [REQUIRED] Channel access token ของ LINE Messaging API (ใช้ส่งแจ้งเตือน)
LINE_CHANNEL_TOKEN=your-line-channel-access-token
# [OPTIONAL] LINE Login channel ID (ผูกบัญชี LINE) — ไม่ตั้ง = ผูก LINE ไม่ได้
LINE_LOGIN_CHANNEL_ID=your-line-login-channel-id
# [OPTIONAL] LINE Login channel secret
LINE_LOGIN_CHANNEL_SECRET=your-line-login-channel-secret
# [OPTIONAL] callback URL ที่ลงทะเบียนไว้ใน LINE Login (หน้า /line-callback ของ frontend)
LINE_LOGIN_CALLBACK_URL=http://localhost:3000/line-callback

# ---------- Telegram ----------
# [OPTIONAL] token ของ Telegram bot — ไม่ตั้ง = ไม่ส่งแจ้งเตือน Telegram
TELEGRAM_BOT_TOKEN=
# [OPTIONAL] username ของ bot (ไม่ต้องมี @) ใช้สร้าง deep link ผูกบัญชี — ไม่ตั้ง = deep_link ว่าง
TELEGRAM_BOT_USERNAME=
# [OPTIONAL แต่แนะนำ] secret ที่ตั้งไว้ตอน setWebhook (header X-Telegram-Bot-Api-Secret-Token)
# ไม่ตั้ง = webhook รับ request โดยไม่ตรวจ header
TELEGRAM_WEBHOOK_SECRET=

# ---------- Email (SMTP via Gmail) ----------
# [OPTIONAL] อีเมลผู้ส่ง (verify / reset password)
SMTP_EMAIL=your-account@gmail.com
# [OPTIONAL] App Password ของ Gmail (ไม่ใช่รหัสผ่านบัญชี)
SMTP_PASSWORD=your-gmail-app-password
# [OPTIONAL] true = ไม่ส่งอีเมล reset password จริง (dev/test) — ยังไม่ครอบคลุมอีเมล verify (default false)
SMTP_DISABLE=false
